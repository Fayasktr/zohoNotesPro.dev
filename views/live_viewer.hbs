<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <!-- Temporarily stash AMD define to ensure Firebase registers globally -->
    <script>
        if (typeof define === 'function' && define.amd) {
            window._savedAmdDefine = window.define;
            window.define = undefined;
        }
    </script>
    <!-- Firebase SDK (Locally Hosted to bypass adblockers & ensure 100% reliability) -->
    <script src="/vendor/firebase/firebase-app-compat.js"></script>
    <script src="/vendor/firebase/firebase-database-compat.js"></script>
    <script>
        if (window._savedAmdDefine) {
            window.define = window._savedAmdDefine;
            delete window._savedAmdDefine;
        }
    </script>

    <style>
        :root {
            --bg-dark: #0f1015;
            --card-bg: #16171f;
            --border-color: rgba(255, 255, 255, 0.08);
            --accent: #6d5dfc;
            --accent-glow: rgba(109, 93, 252, 0.25);
            --text-main: #f1f1f5;
            --text-dim: #8b8c99;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
        }

        pre, code {
            font-family: 'JetBrains Mono', monospace;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }

        .active-host-cell {
            border-color: var(--accent) !important;
            box-shadow: 0 0 20px var(--accent-glow) !important;
        }

        .pulse-live {
            animation: livePulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes livePulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.92); }
        }

        .markdown-render h1 { font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; color: #fff; }
        .markdown-render h2 { font-size: 1.4rem; font-weight: 700; margin-top: 1rem; margin-bottom: 0.5rem; color: #f1f1f5; }
        .markdown-render h3 { font-size: 1.15rem; font-weight: 600; margin-top: 0.75rem; margin-bottom: 0.5rem; color: #e1e1ea; }
        .markdown-render p { margin-bottom: 0.75rem; line-height: 1.6; color: #c4c5d0; }
        .markdown-render ul { list-style-type: disc; margin-left: 1.5rem; margin-bottom: 0.75rem; }
        .markdown-render ol { list-style-type: decimal; margin-left: 1.5rem; margin-bottom: 0.75rem; }
        .markdown-render pre { background: #0b0c10; padding: 1rem; border-radius: 0.75rem; margin-bottom: 0.75rem; border: 1px solid rgba(255,255,255,0.06); }
        .markdown-render code { background: rgba(255,255,255,0.08); padding: 0.2rem 0.4rem; border-radius: 0.25rem; font-size: 0.875rem; }
    </style>
</head>

<body class="min-h-screen flex flex-col">
    <!-- Top Sticky Header -->
    <header class="sticky top-0 z-50 bg-[#12131b]/90 backdrop-blur-md border-b border-[var(--border-color)] px-4 py-3 sm:px-8">
        <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
            <!-- Brand & Status -->
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-[var(--accent)] flex items-center justify-center font-bold text-white shadow-lg shadow-[var(--accent-glow)]">
                    <i data-lucide="monitor-play" class="w-4 h-4"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span id="session-title" class="font-bold text-sm sm:text-base text-white truncate max-w-[200px] sm:max-w-sm">Loading session...</span>
                        <div id="live-badge" class="flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 pulse-live"></span>
                            <span id="live-status-text">LIVE</span>
                        </div>
                    </div>
                    <div class="text-[11px] text-[var(--text-dim)] flex items-center gap-2">
                        <span>Host: <strong id="host-name" class="text-white">Connecting...</strong></span>
                        <span>•</span>
                        <span id="local-exec-notice" class="text-indigo-300 flex items-center gap-1">
                            <i data-lucide="cpu" class="w-3 h-3"></i> Running on Host Device
                        </span>
                    </div>
                </div>
            </div>

            <!-- Controls & Viewers -->
            <div class="flex items-center gap-3">
                <!-- Viewer Count -->
                <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs text-gray-300" title="Active Viewers">
                    <i data-lucide="users" class="w-3.5 h-3.5 text-[var(--accent)]"></i>
                    <span id="viewer-count">1</span> Watching
                </div>

                <!-- Follow Host Toggle -->
                <button id="btn-toggle-follow" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[var(--accent)] text-white shadow-md hover:brightness-110 active:scale-95 transition-all">
                    <i data-lucide="crosshair" class="w-3.5 h-3.5"></i>
                    <span id="follow-text" class="hidden sm:inline">Follow Host</span>
                </button>

                <!-- Copy Link Button -->
                <button id="btn-copy-live-link" class="p-2 sm:px-3 sm:py-1.5 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 border border-white/10 text-gray-200 transition-all flex items-center gap-1.5 active:scale-95" title="Copy Viewing Link">
                    <i data-lucide="share-2" class="w-3.5 h-3.5"></i>
                    <span class="hidden sm:inline">Share</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Disconnected / Offline Banner -->
    <div id="offline-banner" class="hidden bg-amber-500/10 border-b border-amber-500/20 text-amber-300 px-4 py-2 text-center text-xs sm:text-sm font-medium">
        <span class="inline-flex items-center gap-1.5">
            <i data-lucide="pause-circle" class="w-4 h-4"></i>
            Host is currently paused or disconnected. Showing last known state.
        </span>
    </div>

    <!-- Main Live Content Stream -->
    <main class="flex-1 max-w-5xl w-full mx-auto p-4 sm:p-8 space-y-6">
        <!-- Cells Container -->
        <div id="viewer-cells" class="space-y-6">
            <!-- Loading Skeleton -->
            <div id="loading-state" class="p-12 text-center text-[var(--text-dim)] space-y-3">
                <div class="w-10 h-10 border-2 border-[var(--accent)] border-t-transparent rounded-full animate-spin mx-auto"></div>
                <p class="text-sm">Connecting to host session...</p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-auto py-6 border-t border-[var(--border-color)] text-center text-xs text-[var(--text-dim)]">
        <p>Zoho Notes Live Spectator Mode • Read-Only Live View • Real-time Host Synchronization</p>
    </footer>

    <!-- Pass Configuration & Session ID -->
    <script>
        window.SESSION_ID = "{{sessionId}}";
        window.FIREBASE_CONFIG = {{{json firebaseConfig}}};
    </script>
    <script src="/js/live_viewer.js?v=2"></script>
    <script>
        lucide.createIcons();
    </script>
</body>

</html>
