<!DOCTYPE html>
<html lang="en">

<head>
    {{> seo}}
    <meta name="csrf-token" content="{{csrfToken}}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=27">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/split.js/1.6.5/split.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
    <script>
        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' } });
        window.MonacoEnvironment = {
            getWorkerUrl: function (workerId, label) {
                return `data:text/javascript;charset=utf-8,${encodeURIComponent(`
                self.MonacoEnvironment = { baseUrl: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/' };
                importScripts('https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/base/worker/workerMain.js');`
                )}`;
            }
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        /* Custom styles that Tailwind doesn't easily cover or are too specific */
        .sidebar-transition {
            transition: transform 0.3s ease-in-out;
        }

        .mobile-overlay {
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
        }

        .gutter {
            background-color: transparent;
            background-repeat: no-repeat;
            background-position: center;
            transition: background-color 0.2s;
            z-index: 50;
        }

        .gutter:hover {
            background-color: rgba(109, 93, 252, 0.2);
        }

        .gutter.gutter-horizontal {
            cursor: col-resize;
            width: 2px !important;
            /* Extremely thin like a border */
            background-color: var(--border-color);
            transition: background-color 0.2s, width 0.2s;
            z-index: 50;
            position: relative;
        }

        /* Create a wider invisible hit area so it's still easy to grab */
        .gutter.gutter-horizontal::after {
            content: '';
            position: absolute;
            top: 0;
            left: -4px;
            right: -4px;
            bottom: 0;
            z-index: 1;
        }

        .gutter.gutter-horizontal:hover {
            background-color: var(--accent);
            width: 4px !important;
            /* Slightly more visible on hover */
        }

        /* Let Split.js handle the widths */
        #main-sidebar {
            flex-shrink: 0;
        }

        @media (max-width: 1024px) {
            .sidebar-mobile {
                position: fixed;
                height: 100vh;
                z-index: 1000;
                transform: translateX(-100%);
            }

            .sidebar-open {
                transform: translateX(0);
            }
        }
    </style>
</head>

<body class="bg-[var(--bg-dark)] text-[var(--text-main)] overflow-hidden">
    <div class="layout flex h-screen relative" id="layout-container">
        <!-- Mobile Sidebar Overlay -->
        <div id="sidebar-overlay"
            class="mobile-overlay fixed inset-0 z-[999] hidden opacity-0 transition-opacity duration-300"></div>

        <!-- Sidebar -->
        <aside id="main-sidebar"
            class="sidebar sidebar-mobile lg:relative lg:translate-x-0 bg-[var(--sidebar-bg)] border-r border-[#ffffff1a] backdrop-blur-xl flex flex-col px-2.5 py-4 sidebar-transition overflow-y-auto">
            <div class="flex items-center justify-between mb-1 ">
                <div
                    class="logo text-2xl font-extrabold bg-gradient-to-r from-[#6d5dfc] to-[var(--text-main)] bg-clip-text text-transparent flex items-center gap-2">
                    <img src="/images/icon-192.png" alt="Zoho Notes Logo" class="w-8 h-8 rounded-lg object-contain" />
                    <span>Zoho Notes</span>
                </div>
                <button id="close-sidebar" class="lg:hidden text-[#a0a0a0] hover:text-white p-2">
                    <i data-lucide="x"></i>
                </button>
            </div>

            <!-- New World Button -->
            <a href="/game"
                class="w-full p-2 mb-2 bg-gradient-to-r from-[#6d5dfc] to-[#9c5dfc] text-white rounded-xl flex items-center justify-center gap-2 font-bold hover:scale-[1.05] transition-all shadow-lg shadow-[#6d5dfc44] decoration-none no-underline">
                <i data-lucide="globe" class="w-5 h-5"></i>
                Game Changer
            </a>
            <a href="/sharing-notes"
                class="w-full p-3 mb-2 border border-[#ffffff1a] bg-[#6d5dfc1a] text-[#6d5dfc] rounded-xl flex items-center justify-center gap-2 font-bold hover:scale-[1.02] transition-all decoration-none no-underline">
                <i data-lucide="users" class="w-5 h-5"></i>
                Sharing Notes
            </a>


            <!-- Search Bar (Relocated from header) -->
            <div class="relative group w-full mb-5 flex items-center gap-2">
                <div class="relative flex-1">
                    <i data-lucide="search"
                        class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-[#6d5dfc] opacity-50 group-focus-within:opacity-100 transition-opacity"></i>
                    <input type="text" id="notebook-search" placeholder="Search notebooks..."
                        class="w-full bg-[#ffffff05] border border-[#ffffff1a] pl-11 pr-4 py-2.5 rounded-xl outline-none focus:border-[#6d5dfc] focus:ring-4 focus:ring-[#6d5dfc1a] backdrop-blur-md transition-all text-sm text-[var(--text-main)]">
                </div>
                <button
                    class="w-10 h-10 flex items-center justify-center bg-[#6d5dfc1a] border border-[#6d5dfc33] text-[#6d5dfc] rounded-xl hover:bg-[#6d5dfc] hover:text-white transition-all shadow-lg shadow-[#6d5dfc1a] flex-shrink-0"
                    id="sidebar-search-btn" title="Search Notebooks">
                    <i data-lucide="search" class="w-4 h-4"></i>
                </button>
            </div>

            <nav class="flex-1">
                <div class="p-3 rounded-xl mb-2 cursor-pointer transition-all text-[var(--text-dim)] flex items-center gap-3 hover:bg-[var(--card-bg)] hover:text-[var(--text-main)] active"
                    id="toggle-notebooks">
                    <i data-lucide="layers"></i>
                    <span class="flex-1">My Notebooks</span>
                    <button id="add-folder-sidebar" class="p-1 hover:text-[#6d5dfc]" title="Add Folder">
                        <i data-lucide="folder-plus" class="w-4 h-4"></i>
                    </button>
                    <i data-lucide="chevron-down" id="chevron-notebooks"
                        class="w-3.5 transition-transform duration-300"></i>
                </div>
                <div class="notebook-list mt-2 mb-5 transition-all duration-300 overflow-hidden"
                    id="notebook-list">
                    <!-- Dynamic notebooks here -->
                </div>

                <!-- Dedicated Live Notes Section -->
                <div class="live-notes-section mb-4" id="live-notes-section">
                    <div class="flex items-center justify-between p-2.5 rounded-xl mb-1 cursor-pointer transition-all text-[var(--text-dim)] hover:bg-[var(--card-bg)] hover:text-[var(--text-main)]"
                        id="toggle-live-notes">
                        <span class="flex items-center gap-2 font-semibold text-xs tracking-wider uppercase text-rose-400">
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                            </span>
                            <span>Live Notes</span>
                        </span>
                        <div class="flex items-center gap-1.5">
                            <button id="btn-create-live-note" class="p-1 hover:text-rose-400 text-xs flex items-center gap-1 bg-rose-500/10 border border-rose-500/20 rounded-md px-2 py-0.5 text-rose-300 hover:bg-rose-500/20 transition-all font-medium" title="Create New Live Note">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                <span>New Live</span>
                            </button>
                            <i data-lucide="chevron-down" id="chevron-live-notes" class="w-3.5 h-3.5 transition-transform duration-300"></i>
                        </div>
                    </div>
                    <div id="live-notes-list" class="space-y-1 mt-1 pl-1 transition-all duration-300">
                        <!-- Dynamic live notes injected here -->
                    </div>
                </div>

                <div class="flex p-3 rounded-xl mb-2 cursor-pointer transition-all text-[var(--text-dim)] items-center gap-3 hover:bg-[var(--card-bg)] hover:text-[var(--text-main)]"
                    id="nav-starred-cells">
                    <i data-lucide="star" class="fill-[#ffcc00] text-[#ffcc00]"></i> Starred Notes
                </div>
                <div class="flex p-3 rounded-xl mb-2 cursor-pointer transition-all text-[var(--text-dim)] items-center gap-3 hover:bg-[var(--card-bg)] hover:text-[var(--text-main)]"
                    id="nav-trash">
                    <i data-lucide="trash-2"></i> Trash
                </div>
            </nav>

            <div class="mt-auto py-5 border-t border-[var(--border-color)]">
                <div
                    class="flex items-center gap-3 p-2.5 mb-2 rounded-xl cursor-pointer hover:bg-[#9696961a] border border-transparent hover:border-[#ffffff1a] transition-all group">
                    <div class="w-8 h-8 rounded-full bg-[#6d5dfc] flex items-center justify-center font-bold text-sm">
                        {{#if username}}{{substring username 0 1}}{{else}}U{{/if}}
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <div class="text-sm font-semibold truncate">{{username}}</div>
                        <a href="/logout"
                            class="text-[11px] text-[#ff3b30] font-semibold opacity-80 group-hover:opacity-100 hover:underline">Logout
                            Account</a>
                    </div>
                </div>

                <!-- Join Community Button (Left-aligned & Compact) -->
                <button id="btn-join-whatsapp"
                    class="w-full h-10 flex items-center justify-start px-3 gap-3 bg-[#25d36608] border border-[#25d36622] text-[#25d366] rounded-xl text-[10px] font-bold hover:bg-[#25d3661a] hover:scale-[1.02] active:scale-95 transition-all mb-5 group/wa">
                    <img src="/images/whatsapp icon.png" alt="WA"
                        class="w-8 h-10 object-contain group-hover/wa:rotate-12 transition-transform">
                    Join Community
                </button>
                <div class="flex p-3 rounded-xl cursor-pointer transition-all text-[var(--text-dim)] items-center gap-3 hover:bg-[var(--card-bg)] hover:text-[var(--text-main)]"
                    id="nav-settings">
                    <i data-lucide="settings"></i> Settings
                </div>
                <div class="text-[10px] text-[var(--text-dim)] opacity-70 mt-2.5 credit-text text-center w-full">
                    <a href="https://fayasktr.github.io/Fayas-protfolio/" target="_blank" class="hover:underline">©Fayas
                        kp</a>
                </div>
            </div>
        </aside>




        <!-- Main Content -->
        <main id="main-content"
            class="main-content overflow-y-auto h-screen px-4 pb-4 sm:px-5 sm:pb-5 lg:p-10 flex flex-col items-center bg-[var(--bg-dark)]">
            <!-- Mobile Toggle Button (Fixed) -->
            <button id="open-sidebar"
                class="fixed top-4 left-4 z-[100] lg:hidden p-2 text-[#a0a0a5] hover:text-white bg-[#ffffff08] rounded-xl border border-[#ffffff1a] transition-all active:scale-95 backdrop-blur-md">
                <i data-lucide="menu"></i>
            </button>

            <div class="notebook-container w-full max-w-[900px] relative">
                <header class="mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                    <div class="flex items-center gap-2 w-full sm:w-auto flex-1">
                        <input type="text"
                            class="text-2xl lg:text-3xl font-bold bg-transparent border-none text-[var(--text-main)] w-full sm:w-auto flex-1 outline-none focus:border-b focus:border-[#6d5dfc] transition-all"
                            id="notebook-title" value="Untitled Notebook" placeholder="Enter title...">
                        <button
                            class="w-9 h-9 flex items-center justify-center bg-[#30b0ff1a] border border-[#30b0ff33] text-[#30b0ff] rounded-lg hover:bg-[#30b0ff] hover:text-white transition-all flex-shrink-0"
                            id="copy-all-cells" title="Copy All Notes">
                            <i data-lucide="copy" class="w-4 h-4"></i>
                        </button>
                        <button
                            class="w-9 h-9 flex items-center justify-center bg-rose-500/15 border border-rose-500/30 text-rose-400 rounded-lg hover:bg-rose-500 hover:text-white transition-all flex-shrink-0 hidden cursor-pointer relative shadow-sm"
                            id="btn-live-share-header" title="Live Session Active (Click to Copy Link & Details)">
                            <i data-lucide="share-2" class="w-4 h-4"></i>
                            <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5 pointer-events-none">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500 border border-[#16171f]"></span>
                            </span>
                            <span id="btn-live-share-header-text" class="sr-only">Live Share Link</span>
                        </button>
                    </div>

                    <!-- Note Label Search -->
                    <div class="relative group w-full sm:w-72 flex items-center gap-2">
                        <div class="relative flex-1">
                            <i data-lucide="tag"
                                class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-[#30ff6a] opacity-50 group-focus-within:opacity-100 transition-opacity"></i>
                            <input type="text" id="note-label-search" placeholder="Search note label..."
                                class="w-full bg-[#ffffff05] border border-[#ffffff1a] pl-11 pr-4 py-2.5 rounded-xl outline-none focus:border-[#30ff6a] focus:ring-4 focus:ring-[#30ff6a1a] backdrop-blur-md transition-all text-sm text-[var(--text-main)]">
                        </div>
                        <button
                            class="w-10 h-10 flex items-center justify-center bg-[#30ff6a1a] border border-[#30ff6a33] text-[#30ff6a] rounded-xl hover:bg-[#30ff6a] hover:text-white transition-all shadow-lg shadow-[#30ff6a1a] flex-shrink-0"
                            id="note-label-search-btn" title="Filter Notes">
                            <i data-lucide="search" class="w-4 h-4"></i>
                        </button>
                    </div>
                </header>

                <!-- Top Real-Time Collaboration & Active Users Bar (Hidden on Normal Notes) -->
                <div id="collab-top-bar" class="collab-top-bar hidden">
                    <div class="collab-presence-pill">
                        <div class="collab-count-badge">
                            <span class="collab-status-dot"></span>
                            <span id="collab-user-count">1</span> Online
                        </div>
                        <div id="collab-avatars" class="collab-avatars-group">
                            <!-- Injected user avatar chips -->
                        </div>
                        <span id="collab-author-info" class="collab-author-label"></span>
                    </div>

                    <div class="collab-actions">
                        <button id="btn-copy-collab-link" class="btn-collab-share" title="Copy Live Collaborative Link">
                            <i data-lucide="link-2" class="collab-share-icon" style="width: 13px; height: 13px;"></i>
                            <span id="collab-share-btn-text">Copy Live Link</span>
                        </button>
                        <button id="btn-open-collab-modal" class="btn-collab-info" title="View Full Live Session Details & QR">
                            <i data-lucide="info" style="width: 13px; height: 13px;"></i>
                        </button>
                    </div>
                </div>

                <!-- Host Offline Overlay for Live Notes -->
                <div id="collab-host-offline-overlay" class="collab-host-offline-overlay hidden">
                    <div class="collab-offline-card">
                        <div class="collab-offline-icon-wrap">
                            <div class="w-12 h-12 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center mb-3">
                                <i data-lucide="radio" class="w-6 h-6 text-rose-500"></i>
                            </div>
                        </div>
                        <h3 class="text-base font-bold text-white mb-1">Host is Offline</h3>
                        <p class="text-xs text-[#a0a0a5] max-w-xs text-center mb-3">
                            Live editing is paused because the host (<span id="collab-offline-host-name" class="font-semibold text-rose-400">Host</span>) is currently disconnected.
                        </p>
                        <div class="flex items-center gap-2 text-[11px] text-rose-400 bg-rose-500/10 border border-rose-500/20 px-3 py-1 rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                            <span>Waiting for host to reconnect...</span>
                        </div>
                    </div>
                </div>

                <div id="cells-list">
                    <!-- Cells will be dynamiclly injected here -->
                </div>

                <div style="height: 100px;"></div>
            </div>

            <!-- Scroll to Bottom Button (Refined) -->
            <button id="scroll-to-bottom" class="scroll-to-bottom-btn" title="Scroll to Bottom">
                <i data-lucide="chevron-down"></i>
            </button>
        </main>
    </div>

    <!-- Floating Actions -->
    <div class="controls">
        <button class="btn-floating" id="add-code-cell" title="Add Note">
            <i data-lucide="plus"></i>
        </button>
        <button class="btn-floating" id="run-all-cells" title="Run All">
            <i data-lucide="play"></i>
        </button>

        <button class="btn-floating" style="background: #ff3b30;" id="clear-all-outputs" title="Clear All Outputs">
            <i data-lucide="eraser"></i>
        </button>
    </div>

    <!-- Generic Modal Structure -->
    <div id="modal-overlay" class="modal-overlay hidden">
        <!-- New Folder Modal -->
        <div id="modal-folder" class="modal-content hidden">
            <button class="modal-btn-x modal-close">&times;</button>
            <div
                class="modal-icon text-[#6d5dfc] bg-[#6d5dfc1a] w-20 h-20 rounded-3xl mx-auto mb-6 flex items-center justify-center shadow-lg shadow-[#6d5dfc33]">
                <i data-lucide="folder-plus" class="w-10 h-10"></i>
            </div>
            <h2>Create New Folder</h2>
            <p>Organize your thoughts into a new workspace.</p>
            <input type="text" id="input-folder-name" placeholder="Folder name..." value="New Folder">
            <button class="btn-primary" id="btn-confirm-folder">Create Folder</button>
        </div>

        <!-- New File Modal -->
        <div id="modal-file" class="modal-content hidden">
            <button class="modal-btn-x modal-close">&times;</button>
            <div
                class="modal-icon text-[#30ff6a] bg-[#30ff6a1a] w-20 h-20 rounded-3xl mx-auto mb-6 flex items-center justify-center shadow-lg shadow-[#30ff6a33]">
                <i data-lucide="file-plus" class="w-10 h-10"></i>
            </div>
            <h2>Create New File</h2>
            <p>Start a new note in <span id="target-folder-name">root</span></p>
            <input type="text" id="input-file-name" placeholder="File title..." value="New File">
            <button class="btn-primary" id="btn-confirm-file">Create File</button>
        </div>

        <!-- Settings Modal -->
        <div id="modal-settings" class="modal-content hidden">
            <button class="modal-btn-x modal-close">&times;</button>
            <div class="modal-icon"
                style="background: var(--accent); border-radius: 50%; width: 60px; height: 60px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 24px;">
                {{#if username}}{{substring username 0 1}}{{else}}U{{/if}}
            </div>
            <h2>Settings</h2>
            <p>Manage your account and preferences.</p>

            <div class="settings-group">
                <div class="user-info-large">
                    <strong>{{username}}</strong>
                    <span>User Account</span>
                </div>
            </div>

            <div class="settings-group">
                <div class="theme-toggle-row">
                    <span>Appearance (Light Mode)</span>
                    <label class="switch">
                        <input type="checkbox" id="theme-switch">
                        <span class="slider round"></span>
                    </label>
                </div>
                <div class="theme-toggle-row" style="margin-top: 15px;">
                    <div>
                        <span>Smart Output</span>
                        <p style="font-size: 10px; color: var(--text-dim); margin-top: 2px;">Show last result
                            automatically <a href="/special/smart-output.html"
                                class="text-[#6d5dfc] hover:underline ml-1" target="_blank"
                                style="font-weight: 600;">More</a></p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" id="smart-output-switch">
                        <span class="slider round"></span>
                    </label>
                </div>
                <!-- Default Language Setting -->
                <div style="margin-top: 20px; text-align: left;">
                    <label
                        style="display: block; font-size: 11px; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px;">Default
                        Programming Language</label>
                    <div class="relative">
                        <select id="setting-default-lang"
                            style="width: 100%; background: var(--bg-dark); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px; border-radius: 8px; font-size: 13px; outline: none; appearance: none; cursor: pointer;">
                            <option value="javascript" {{#if (eq defaultLanguage 'javascript' )}}selected{{/if}}>
                                JavaScript</option>
                            <option value="typescript" {{#if (eq defaultLanguage 'typescript' )}}selected{{/if}}>TypeScript</option>
                            <option value="python" {{#if (eq defaultLanguage 'python' )}}selected{{/if}}>Python</option>
                            <option value="java" {{#if (eq defaultLanguage 'java' )}}selected{{/if}}>Java</option>
                            <option value="c" {{#if (eq defaultLanguage 'c' )}}selected{{/if}}>C</option>
                            <option value="cpp" {{#if (eq defaultLanguage 'cpp' )}}selected{{/if}}>C++</option>
                        </select>
                        <i data-lucide="chevron-down"
                            style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); width: 14px; pointer-events: none; color: var(--text-dim);"></i>
                    </div>
                    <p style="font-size: 10px; opacity: 0.5; margin-top: 5px;">New code cells will use this language by
                        default.</p>
                </div>

                <!-- Feedback Section -->
                <div style="margin-top: 25px; pt-5 border-t border-[var(--border-color)]; text-align: left;">
                    <label
                        style="display: block; font-size: 11px; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px;">Send
                        Feedback to Admin</label>
                    <textarea id="feedback-message" placeholder="Found a bug? Have a suggestion?"
                        style="width: 100%; background: var(--bg-dark); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px; border-radius: 8px; font-size: 13px; outline: none; resize: none; min-height: 60px; margin-bottom: 10px;"></textarea>

                    <button class="btn-primary" id="btn-send-feedback"
                        style="width: 100%; font-size: 12px; padding: 10px;">Send Feedback</button>

                    {{#if isAdmin}}
                    <div
                        style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 10px;">
                        <a href="/admin/dashboard" class="btn-secondary"
                            style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; border-color: #6d5dfc; color: #6d5dfc; text-decoration: none;">
                            <i data-lucide="shield-check" style="width: 14px;"></i>
                            Admin Dashboard
                        </a>
                    </div>
                    {{/if}}
                </div>
            </div>

            <div style="margin-top: 25px; pt-5 border-t border-[var(--border-color)]">
                <a href="/special/user-manual.html" target="_blank"
                    class="flex items-center gap-2 text-[var(--accent)] hover:underline font-semibold mb-4 transition-all">
                    <i data-lucide="help-circle" style="width: 16px;"></i> User Manual
                </a>
                <a href="/logout" class="btn-danger-outline">Logout Account</a>
            </div>
        </div>

        <!-- Generic Input Modal (Rename) -->
        <div id="modal-input" class="modal-content hidden">
            <button class="modal-btn-x modal-close">&times;</button>
            <div class="modal-icon">
                <i data-lucide="edit-3" style="width: 50px; height: 50px; color: var(--accent);"></i>
            </div>
            <h2 id="modal-input-title">Rename</h2>
            <p id="modal-input-desc">Enter a new name.</p>
            <input type="text" id="modal-input-field" placeholder="Type here...">
            <div class="modal-footer">
                <button class="btn-primary" id="btn-modal-input-confirm">Confirm</button>
                <button class="btn-secondary modal-close">Cancel</button>
            </div>
        </div>

        <!-- Generic Alert Modal (Confirmation) -->
        <div id="modal-alert" class="modal-content hidden">
            <button class="modal-btn-x modal-close">&times;</button>
            <div class="modal-icon">
                <i data-lucide="alert-triangle" style="width: 50px; height: 50px; color: #ff3b30;"></i>
            </div>
            <h2 id="modal-alert-title">Are you sure?</h2>
            <p id="modal-alert-desc">This action cannot be undone.</p>
            <div class="modal-footer">
                <button class="btn-primary" id="btn-modal-alert-confirm" style="background: #ff3b30;">Confirm</button>
                <button class="btn-secondary modal-close">Cancel</button>
            </div>
        </div>

        <!-- WhatsApp Community Modal -->
        <div id="modal-whatsapp" class="modal-content hidden">
            <div class="modal-header border-b border-[#ffffff1a] pb-4 mb-4">
                <h3 class="text-xl font-bold flex items-center gap-2 text-[#25d366]">
                    <i data-lucide="message-circle"></i> Join Our Community
                </h3>
                <p class="text-xs text-[var(--text-dim)] mt-1">Scan the QR code to join the Zoho Notes community group.
                </p>
            </div>
            <div class="flex flex-col items-center gap-6 py-4">
                <div class="bg-white p-4 rounded-2xl shadow-2xl">
                    <img src="/images/Zoho notes by fayas kp.png" alt="WhatsApp QR Code"
                        class="w-64 h-64 object-contain">
                </div>
                <div class="text-center px-4">
                    <p class="text-sm text-[var(--text-main)] font-semibold mb-1">Connect & Collaborate!</p>
                    <p class="text-xs text-[var(--text-dim)] leading-relaxed">Join our vibrant community of note-takers.
                        Share tips, get fast support, and stay updated with the latest features from Fayas KP.</p>
                    <a href="https://www.linkedin.com/in/fayas-kp-ktr" target="_blank"
                        class="w-full p-3 mb-2 border border-[#ffffff1a] bg-[#6d5dfc1a] text-[#6d5dfc] rounded-xl flex items-center justify-center gap-2 font-bold hover:scale-[1.02] transition-all decoration-none no-underline">
                        <i data-lucide="linkedin" class="w-5 h-5"></i>
                        Connect Linkedin
                    </a>
                </div>
            </div>
            <div class="modal-footer mt-6 flex justify-end">
                <button
                    class="px-6 py-2.5 bg-[#ffffff10] hover:bg-[#ffffff1a] text-[var(--text-main)] rounded-xl transition-all modal-close font-semibold">Close</button>
            </div>
        </div>

        <!-- Live Broadcast Modal -->
        <div id="modal-live-broadcast" class="modal-content hidden" style="max-width: 480px; width: 100%;">
            <button class="modal-btn-x modal-close">&times;</button>
            <div class="modal-icon text-[#6d5dfc] bg-[#6d5dfc1a] w-16 h-16 rounded-3xl mx-auto mb-4 flex items-center justify-center shadow-lg shadow-[#6d5dfc33]">
                <i data-lucide="radio" class="w-8 h-8"></i>
            </div>
            <h2>Live Spectator Broadcast</h2>
            <p style="margin-bottom: 20px;">Share a link so anyone can watch you type and run code in real time.</p>

            <!-- Status Banner -->
            <div id="broadcast-status-card" style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); border-radius: 12px; padding: 14px; margin-bottom: 18px; text-align: left;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <div style="font-size: 11px; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">Broadcast Status</div>
                        <div id="broadcast-status-label" style="font-size: 13px; font-weight: 700; color: #a0a0b0; display: flex; align-items: center; gap: 6px; margin-top: 4px;">
                            <span style="width: 8px; height: 8px; border-radius: 50%; background: #6b7280; display: inline-block;"></span> Inactive
                        </div>
                    </div>
                    <div id="broadcast-viewers-tag" class="hidden" style="font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 20px; background: rgba(109, 93, 252, 0.15); color: #6d5dfc; border: 1px solid rgba(109, 93, 252, 0.3);">
                        <span id="broadcast-viewers-count">0</span> Watching
                    </div>
                </div>
            </div>

            <!-- Inactive State Controls -->
            <div id="broadcast-inactive-controls">
                <button class="btn-primary" id="btn-start-broadcast" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; font-weight: 700;">
                    <i data-lucide="play" style="width: 16px;"></i> Start Live Broadcast
                </button>
            </div>

            <!-- Active State Controls -->
            <div id="broadcast-active-controls" class="hidden" style="text-align: left;">
                <label style="display: block; font-size: 11px; text-transform: uppercase; color: var(--text-dim); margin-bottom: 6px;">Spectator View Link</label>
                <div style="display: flex; gap: 8px; margin-bottom: 15px;">
                    <input type="text" id="live-share-link-input" readonly style="flex: 1; background: rgba(0,0,0,0.4); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px; border-radius: 8px; font-family: monospace; font-size: 11px; outline: none;" onclick="this.select();">
                    <button class="btn-primary" id="btn-copy-broadcast-link" style="padding: 10px 16px; font-size: 12px; display: flex; align-items: center; gap: 6px;">
                        <i data-lucide="copy" style="width: 14px;"></i> Copy
                    </button>
                </div>

                <div style="background: rgba(48, 255, 106, 0.08); border: 1px solid rgba(48, 255, 106, 0.2); border-radius: 8px; padding: 10px; font-size: 11px; color: #30ff6a; display: flex; align-items: center; gap: 8px; margin-bottom: 15px;">
                    <i data-lucide="cpu" style="width: 16px; flex-shrink: 0;"></i>
                    <span>Code executes locally on <strong>your machine</strong>. Viewers only see real-time output.</span>
                </div>

                <button id="btn-stop-broadcast" class="btn-danger-outline" style="width: 100%; padding: 10px; font-size: 12px; display: flex; align-items: center; justify-content: center; gap: 6px;">
                    <i data-lucide="square" style="width: 14px;"></i> Stop Broadcast
                </button>
            </div>
        </div>

        <!-- Dedicated Live Collaborative Share Link Modal -->
        <div id="modal-live-share" class="modal-content hidden" style="max-width: 500px; width: 100%;">
            <button class="modal-btn-x modal-close">&times;</button>
            <div class="modal-icon text-rose-500 bg-rose-500/10 w-16 h-16 rounded-3xl mx-auto mb-4 flex items-center justify-center border border-rose-500/20 shadow-lg shadow-rose-500/10">
                <i data-lucide="radio" class="w-8 h-8 text-rose-500"></i>
            </div>
            <h2 id="live-share-modal-title" class="text-xl font-bold text-[var(--text-main)] mb-1">Live Share Link</h2>
            <p class="text-xs text-[var(--text-dim)] mb-5">
                Share this link with anyone to code together in real-time.
            </p>

            <div class="bg-[var(--bg-dark)] border border-[var(--border-color)] rounded-xl p-3 mb-4 text-left">
                <label class="block text-[10px] font-semibold text-[var(--text-dim)] uppercase tracking-wider mb-1.5">
                    Live Session Link (Click to Copy)
                </label>
                <div class="flex items-center gap-2">
                    <input type="text" id="live-share-modal-input" readonly
                        class="flex-1 bg-transparent border-none text-xs font-mono text-[var(--text-main)] outline-none select-all cursor-pointer"
                        placeholder="Generating link...">
                    <button id="btn-copy-modal-link" class="px-3.5 py-2 bg-rose-500 hover:bg-rose-600 text-white rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 flex-shrink-0 shadow-md shadow-rose-500/20 cursor-pointer">
                        <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                        <span id="btn-copy-modal-link-text">Copy Link</span>
                    </button>
                </div>
            </div>

            <div class="flex items-start gap-2.5 p-3 rounded-xl bg-rose-500/5 border border-rose-500/20 text-rose-300 text-[11px] mb-4 text-left leading-relaxed">
                <i data-lucide="info" class="w-4 h-4 text-rose-400 mt-0.5 flex-shrink-0"></i>
                <div>
                    <strong>How Live Sharing Works:</strong> Collaborators open this link, log in, and their edits and code runs sync automatically with you in real time. (Live editing is active while you, the host, are connected).
                </div>
            </div>

            <!-- Link Management & Deletion Actions -->
            <div id="live-share-modal-danger-zone" class="p-3 rounded-xl bg-red-500/5 border border-red-500/20 mb-5 text-left">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-bold text-rose-400 uppercase tracking-wider">Live Link Management</span>
                    <span class="text-[10px] text-[var(--text-dim)]">Host controls</span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button id="btn-revoke-live-link" class="px-3 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border border-rose-500/30 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer" title="Invalidate and delete the live share link">
                        <i data-lucide="link-2-off" class="w-3.5 h-3.5 text-rose-400"></i>
                        <span>Delete Live Link</span>
                    </button>
                    <button id="btn-delete-live-note-modal" class="px-3 py-1.5 bg-red-600/15 hover:bg-red-600/30 text-red-300 border border-red-500/30 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer" title="Delete this entire live notebook">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5 text-red-400"></i>
                        <span>Delete Live Note</span>
                    </button>
                </div>
            </div>

            <div class="modal-footer flex items-center justify-between gap-3 pt-3 border-t border-[var(--border-color)]">
                <a id="btn-open-live-guest-view" href="#" target="_blank"
                    class="px-4 py-2 bg-[#ffffff10] hover:bg-[#ffffff1a] text-xs text-[var(--text-main)] rounded-xl transition-all flex items-center gap-1.5 no-underline">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    <span>Open in New Tab</span>
                </a>
                <button class="px-6 py-2 bg-[#ffffff15] hover:bg-[#ffffff25] text-[var(--text-main)] text-xs font-bold rounded-xl transition-all modal-close">
                    Close
                </button>
            </div>
        </div>

        <script>
            window.USER_SETTINGS = {
                defaultLanguage: '{{defaultLanguage}}'
            };
            window.CURRENT_USER = {
                id: '{{userId}}',
                username: '{{username}}',
                email: '{{userEmail}}'
            };
            window.INITIAL_NOTE_ID = '{{initialNoteId}}';
            window.FIREBASE_CONFIG = {{{json firebaseConfig}}};
        </script>
        <!-- Dexie IndexedDB Engine -->
        <script src="https://cdn.jsdelivr.net/npm/dexie@3.2.4/dist/dexie.min.js"></script>
        <!-- Local-First Database & Sync Engine -->
        <script src="/js/db/database.js?v=25"></script>
        <script src="/js/db/syncEngine.js?v=25"></script>
        <!-- Client-Side Polyglot Browser Engine (WASM + JS/TS) -->
        <script src="/js/engine/browserEngine.js?v=25"></script>
        <!-- Offline Manager & Sync Badge -->
        <script src="/js/offlineManager.js?v=25"></script>
        <!-- Temporarily stash Monaco AMD define to force Firebase to register on window.firebase -->
        <script>
            if (typeof define === 'function' && define.amd) {
                window._monacoAmdDefine = window.define;
                window.define = undefined;
            }
        </script>
        <!-- Firebase SDK (Locally Hosted to bypass adblockers & ensure 100% reliability) -->
        <script src="/vendor/firebase/firebase-app-compat.js"></script>
        <script src="/vendor/firebase/firebase-database-compat.js"></script>
        <!-- Restore Monaco AMD define -->
        <script>
            if (window._monacoAmdDefine) {
                window.define = window._monacoAmdDefine;
                delete window._monacoAmdDefine;
            }
        </script>
        <script src="/js/broadcast_engine.js?v=25"></script>
        <!-- Real-Time Collaboration Engine -->
        <script src="/js/collab_engine.js?v=30"></script>
        <!-- Core Notebook UI Application -->
        <script src="/js/notebook.js?v=30"></script>
        <!-- Progressive Web App Handler -->
        <script src="/js/pwa.js?v=25"></script>
        <script>
            lucide.createIcons();
        </script>
</body>

</html>