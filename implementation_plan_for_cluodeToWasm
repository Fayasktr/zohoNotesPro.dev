// public/js/engine/browserEngine.js — Conceptual
class BrowserEngine {
  async execute(code, lang) {
    switch (lang.toLowerCase()) {
      case 'javascript': case 'js':
        return this.jsRunner.run(code);          // 100% local
        
      case 'typescript': case 'ts':
        return this.tsRunner.run(code);          // 100% local
        
      case 'python': case 'py':
        return this.pyodideRunner.run(code);     // 100% local (WASM)
        
      case 'c': case 'cpp': case 'c++': case 'java':
        return this.serverRunner.run(code, lang); // Server — unchanged!
    }
  }
}

// The server runner is just the current fetch call — nothing changes for C/C++/Java
class ServerRunner {
  async run(code, lang) {
    const res = await fetch('/api/execute', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code, lang })
    });
    return res.json();
  }
}
```

#### JavaScript Sandboxing (Security):

```javascript
// We DON'T use eval() directly — that's dangerous
// Instead, we use a sandboxed iframe with postMessage

class JSRunner {
  constructor() {
    // Create an invisible, sandboxed iframe
    this.iframe = document.createElement('iframe');
    this.iframe.sandbox = 'allow-scripts';  // No DOM access, no network, no storage
    this.iframe.style.display = 'none';
    document.body.appendChild(this.iframe);
  }

  run(code) {
    return new Promise((resolve) => {
      // Send code to iframe via postMessage
      // Iframe runs it in isolation
      // Iframe sends results back via postMessage
      // We capture console.log, errors, return values
    });
  }
}
```

