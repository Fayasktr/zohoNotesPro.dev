        {
          "id": "cell-r5bgzcjcv",
          "type": "code",
          "title": "department and it's total salary",
          "content": "const employees = [\r\n  { id: 1, name: \"Asha\", dept: \"IT\", salary: 50000 },\r\n  { id: 2, name: \"Rahul\", dept: \"HR\", salary: 40000 },\r\n  { id: 3, name: \"Anu\", dept: \"IT\", salary: 60000 },\r\n  { id: 4, name: \"Vishnu\", dept: \"HR\", salary: 45000 },\r\n  { id: 5, name: \"Kiran\", dept: \"IT\", salary: 55000 }\r\n];\r\n\r\nlet obj={}\r\n\r\nfor(let val of employees){\r\n    let dept=val.dept;\r\n    if(!obj[dept]){\r\n        obj[dept]=0;\r\n    }\r\n    let total=val.salary\r\n    total=Number(total)\r\n    obj[dept]=obj[dept]+total\r\n}\r\nconsole.log(obj)\r\n\r\n",
          "output": {
            "id": "81f08006-4079-401f-bdfa-74f81658cf24",
            "success": true,
            "result": "1",
            "logs": [
              "{\n  \"IT\": 165000,\n  \"HR\": 85000\n}"
            ]
          }
